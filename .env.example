# Shell ortamına kendiniz yükleyin; uygulama .env dosyasını otomatik okumaz.
REWB_MCP_URL=
REWB_MCP_TRANSPORT=streamable-http
REWB_MCP_AUTH=none
REWB_MCP_TOKEN_ENV=REWB_MCP_TOKEN
REWB_MCP_TOKEN=
REWB_MCP_TIMEOUT=20
# İsteğe bağlı: yerel JSON ayar dosyasının yolu
REWB_MCP_CONFIG=
# Rootless Podman içinde önceden kurulmuş Python3+strace analiz imajının ID'si
REWB_SANDBOX_IMAGE=
